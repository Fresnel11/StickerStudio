{
  "name": "@sticker-studio/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "google:check": "node scripts/check-google-config.js",
    "start": "node src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "db:check": "node scripts/db-check.js",
    "db:prepare-test": "node scripts/db-prepare-test.js",
    "db:setup": "node scripts/db-local.js setup",
    "db:start": "node scripts/db-local.js start",
    "db:stop": "node scripts/db-local.js stop",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src tests scripts *.json"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "google-auth-library": "^10.0.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  }
}
